<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default recruitment stages (extend Odoo's built-in hr.recruitment.stage) -->
        <record id="stage_new" model="hr.recruitment.stage">
            <field name="name">New Application</field>
            <field name="sequence">1</field>
            <field name="requirements">Application received and under review</field>
            <field name="legend_blocked">Application blocked</field>
            <field name="legend_done">Application processed</field>
            <field name="legend_normal">New Application</field>
        </record>

        <record id="stage_screening" model="hr.recruitment.stage">
            <field name="name">Screening</field>
            <field name="sequence">2</field>
            <field name="requirements">AI scoring and initial phone screening</field>
        </record>

        <record id="stage_interview_1" model="hr.recruitment.stage">
            <field name="name">First Interview</field>
            <field name="sequence">3</field>
            <field name="requirements">HR interview scheduled</field>
        </record>

        <record id="stage_interview_2" model="hr.recruitment.stage">
            <field name="name">Technical Interview</field>
            <field name="sequence">4</field>
            <field name="requirements">Technical or panel interview scheduled</field>
        </record>

        <record id="stage_offer" model="hr.recruitment.stage">
            <field name="name">Offer Stage</field>
            <field name="sequence">5</field>
            <field name="requirements">Offer drafted and pending approval</field>
        </record>

        <record id="stage_contract" model="hr.recruitment.stage">
            <field name="name">Contract</field>
            <field name="sequence">6</field>
            <field name="requirements">Offer accepted, contract being prepared</field>
        </record>

        <record id="stage_onboarding" model="hr.recruitment.stage">
            <field name="name">Onboarding</field>
            <field name="sequence">7</field>
            <field name="requirements">Employee created and onboarding started</field>
        </record>
    </data>
</odoo>
