<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="action_send_application_received_email" model="ir.actions.server">
            <field name="name">Send application received email</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
template = env.ref('hr_recruitment_onboarding.email_template_application_received', raise_if_not_found=False)
if template:
    for record in records:
        template.send_mail(record.id, force_send=True)
            ]]></field>
        </record>
        <record id="action_send_stage_change_email" model="ir.actions.server">
            <field name="name">Send stage change notification</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
template = env.ref('hr_recruitment_onboarding.email_template_stage_change', raise_if_not_found=False)
if template:
    for record in records:
        template.send_mail(record.id, force_send=True)
            ]]></field>
        </record>
        <record id="action_start_onboarding_code" model="ir.actions.server">
            <field name="name">Start onboarding plan</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
for record in records:
    if record.onboarding_id and record.onboarding_id.state == 'draft':
        record.onboarding_id.action_start()
            ]]></field>
        </record>
        <record id="automation_application_received" model="base.automation">
            <field name="name">Recruitment: Send auto-reply on new application</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="trigger">on_create</field>
            <field name="active" eval="True"/>
            <field name="action_server_ids" eval="[(4, ref('action_send_application_received_email'))]"/>
        </record>
        <record id="automation_stage_change_notify" model="base.automation">
            <field name="name">Recruitment: Notify candidate on stage change</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="trigger">on_write</field>
            <field name="filter_pre_domain">[['stage_id','!=',False]]</field>
            <field name="filter_domain">[['stage_id','!=',False]]</field>
            <field name="active" eval="True"/>
            <field name="action_server_ids" eval="[(4, ref('action_send_stage_change_email'))]"/>
        </record>
        <record id="automation_start_onboarding" model="base.automation">
            <field name="name">Recruitment: Auto-start onboarding on hire stage</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="trigger">on_write</field>
            <field name="filter_domain">[['stage_id.name','=','Onboarding']]</field>
            <field name="active" eval="True"/>
            <field name="action_server_ids" eval="[(4, ref('action_start_onboarding_code'))]"/>
        </record>
        <record id="action_cron_overdue_reminders" model="ir.actions.server">
            <field name="name">Cron: Onboarding overdue reminders</field>
            <field name="model_id" ref="model_hr_onboarding_task"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[model._send_overdue_reminders()]]></field>
        </record>
        <record id="cron_onboarding_overdue_reminders" model="ir.cron">
            <field name="name">Onboarding: Send overdue task reminders</field>
            <field name="model_id" ref="model_hr_onboarding_task"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="ir_actions_server_id" ref="action_cron_overdue_reminders"/>
        </record>
        <record id="action_cron_approval_escalation" model="ir.actions.server">
            <field name="name">Cron: Approval escalation</field>
            <field name="model_id" ref="model_hr_recruitment_approval"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[model._escalate_overdue_approvals()]]></field>
        </record>
        <record id="cron_approval_escalation" model="ir.cron">
            <field name="name">Recruitment Approval: Escalate overdue approvals</field>
            <field name="model_id" ref="model_hr_recruitment_approval"/>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
            <field name="ir_actions_server_id" ref="action_cron_approval_escalation"/>
        </record>
    </data>
</odoo>
