<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_hr_recruitment_user" model="res.groups">
            <field name="name">HR Recruitment / User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_hr_recruitment_officer" model="res.groups">
            <field name="name">HR Recruitment / Officer</field>
            <field name="implied_ids" eval="[(4, ref('group_hr_recruitment_user'))]"/>
        </record>
        <record id="group_hr_manager" model="res.groups">
            <field name="name">HR Recruitment / Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_hr_recruitment_officer'))]"/>
        </record>
        <record id="rule_onboarding_own_employee" model="ir.rule">
            <field name="name">Onboarding: Employee sees own plan</field>
            <field name="model_id" ref="model_hr_onboarding"/>
            <field name="domain_force">['|',('employee_id.user_id','=',user.id),('hr_responsible_id.user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_hr_recruitment_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <record id="rule_onboarding_officer" model="ir.rule">
            <field name="name">Onboarding: Officer sees all plans</field>
            <field name="model_id" ref="model_hr_onboarding"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_hr_recruitment_officer'))]"/>
        </record>
    </data>
</odoo>
