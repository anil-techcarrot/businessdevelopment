<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_linkedin_import_wizard_form" model="ir.ui.view">
            <field name="name">hr.linkedin.import.wizard.form</field>
            <field name="model">hr.linkedin.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import LinkedIn Candidate">
                    <group string="Job &amp; LinkedIn URL">
                        <field name="job_id" required="1"/>
                        <field name="linkedin_url" widget="url"/>
                        <field name="use_api"/>
                    </group>
                    <group string="Candidate Information">
                        <group>
                            <field name="candidate_name" required="1"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="headline"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="skills_text"
                                   placeholder="Python, Django, REST APIs, SQL..."/>
                        </group>
                        <field name="summary" colspan="2"
                               placeholder="Candidate summary..."/>
                    </group>
                    <footer>
                        <button name="action_import" string="Import as Applicant"
                                type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
        <record id="action_hr_linkedin_import" model="ir.actions.act_window">
            <field name="name">Import LinkedIn Candidate</field>
            <field name="res_model">hr.linkedin.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
