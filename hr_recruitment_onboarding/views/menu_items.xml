<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_all_applications" model="ir.actions.act_window">
            <field name="name">All Applications</field>
            <field name="res_model">hr.applicant</field>
            <field name="view_mode">list,kanban,form</field>
        </record>
        <record id="action_job_positions" model="ir.actions.act_window">
            <field name="name">Job Positions</field>
            <field name="res_model">hr.job</field>
            <field name="view_mode">list,kanban,form</field>
        </record>
        <record id="action_hr_recruitment_approval" model="ir.actions.act_window">
            <field name="name">Recruitment Approvals</field>
            <field name="res_model">hr.recruitment.approval</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_hr_onboarding" model="ir.actions.act_window">
            <field name="name">Onboarding Plans</field>
            <field name="res_model">hr.onboarding</field>
            <field name="view_mode">list,kanban,form</field>
        </record>
        <record id="action_hr_onboarding_task_my" model="ir.actions.act_window">
            <field name="name">My Onboarding Tasks</field>
            <field name="res_model">hr.onboarding.task</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('assigned_to_id','=',uid)]</field>
        </record>
        <record id="action_hr_onboarding_task_template" model="ir.actions.act_window">
            <field name="name">Onboarding Task Templates</field>
            <field name="res_model">hr.onboarding.task.template</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="action_res_config_settings_recruitment" model="ir.actions.act_window">
            <field name="name">Recruitment &amp; Onboarding Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module': 'hr_recruitment_onboarding'}</field>
        </record>

        <menuitem id="menu_recruitment_onboarding_root"
                  name="Recruitment &amp; Onboarding"
                  sequence="80"
                  web_icon="hr_recruitment_onboarding,static/description/icon.png"/>
        <menuitem id="menu_recruitment_main"
                  name="Recruitment"
                  parent="menu_recruitment_onboarding_root"
                  sequence="10"/>
        <menuitem id="menu_all_applications"
                  name="All Applications"
                  parent="menu_recruitment_main"
                  action="action_all_applications"
                  sequence="10"/>
        <menuitem id="menu_job_positions"
                  name="Job Positions"
                  parent="menu_recruitment_main"
                  action="action_job_positions"
                  sequence="20"/>
        <menuitem id="menu_approvals"
                  name="Approvals"
                  parent="menu_recruitment_main"
                  action="action_hr_recruitment_approval"
                  sequence="30"
                  groups="hr_recruitment_onboarding.group_hr_recruitment_officer"/>
        <menuitem id="menu_onboarding_main"
                  name="Onboarding"
                  parent="menu_recruitment_onboarding_root"
                  sequence="20"/>
        <menuitem id="menu_all_onboarding"
                  name="All Onboarding Plans"
                  parent="menu_onboarding_main"
                  action="action_hr_onboarding"
                  sequence="10"/>
        <menuitem id="menu_onboarding_tasks"
                  name="My Tasks"
                  parent="menu_onboarding_main"
                  action="action_hr_onboarding_task_my"
                  sequence="20"/>
        <menuitem id="menu_onboarding_templates"
                  name="Task Templates"
                  parent="menu_onboarding_main"
                  action="action_hr_onboarding_task_template"
                  sequence="30"
                  groups="hr_recruitment_onboarding.group_hr_recruitment_officer"/>
        <menuitem id="menu_recruitment_config"
                  name="Configuration"
                  parent="menu_recruitment_onboarding_root"
                  sequence="99"
                  groups="hr_recruitment_onboarding.group_hr_manager"/>
        <menuitem id="menu_recruitment_settings"
                  name="Settings"
                  parent="menu_recruitment_config"
                  action="action_res_config_settings_recruitment"
                  sequence="10"/>
    </data>
</odoo>
